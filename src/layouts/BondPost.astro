---
import Shell from './Shell.astro';
import Ad from '../components/Ad.astro';
import {bondPosts,bondData,bondArticles,bondUrl,articleUrl,dateLabel,md,clean} from '../lib/content.mjs';
const {post,article}=Astro.props;
const articles=article?[article]:post.articles;
const original=article?bondArticles.find(a=>a.id===article.id):bondData.briefings.find(b=>b.id===post.id);
const title=article?article.heading:post.title;
const related=bondPosts.filter(p=>p.id!==post.id&&p.articles.some(a=>articles.some(b=>a.originalTitle.toLowerCase()===b.originalTitle.toLowerCase()))).slice(0,3);
const raw=original.body.replace(/[^]*/g,'');
const nodes=post.figure==='credit'?['Company data','Credit risk','Investment decision']:post.figure==='returns'?['Market data','Return forecasts','Validation']:['Research question','Model & tests','Validation'];
---
<Shell title={title} description={clean(article?article.paragraphs[0]:post.intro)} section="bondnote" article>
<div class="wrap reader-wrap"><header class="reader-header"><nav class="breadcrumb"><a href="/bondnote/">Bondnote</a><span>/</span>{article?<a href={bondUrl(post)}>{dateLabel(post.date)} briefing</a>:<span>Briefing</span>}</nav><span class="eyebrow">BONDNOTE JOURNAL · {dateLabel(post.date)}</span><h1>{title}</h1><p class="deck" set:html={md.renderInline(article?article.paragraphs[0]:post.intro)}/><div class="reader-meta"><time datetime={post.date}>{dateLabel(post.date)}</time><span>{article?Math.max(2,Math.round(post.readMinutes/5)):post.readMinutes} min read</span><span>{article?'RESEARCH NOTE':`${post.articles.length} RESEARCH NOTES`}</span></div></header>
<div class="reader-grid"><article>
{!article&&<figure class="concept"><span class="small-label">READING FRAMEWORK</span><div class="concept-flow">{nodes.map((n,i)=><><span>{n}</span>{i<2&&<b>→</b>}</>)}</div><figcaption>A conceptual reading guide, not a chart of measured data or performance.</figcaption></figure>}
{articles.map((a,i)=><section class="research-section prose" id={'note-'+a.id}>{!article&&<><span class="eyebrow">{String(i+1).padStart(2,'0')} / RESEARCH NOTE</span><h2><a href={articleUrl(a)}>{a.heading}</a></h2></>}<div class="original-title">Source discussed · {a.originalTitle}</div>{a.paragraphs.slice(article?1:0).map(p=><p set:html={md.renderInline(p)}/>)}{a.implications.length>0&&<aside class="editor-note"><h3>How this might apply in practice</h3>{a.implications.map(p=><p set:html={md.renderInline(p)}/>)}<small>Interpretations and ideas from the original briefing.</small></aside>}{a.caveats.length>0&&<aside class="editor-note"><h3>What to check</h3>{a.caveats.map(p=><p set:html={md.renderInline(p)}/>)}</aside>}<div class="source-links">{a.links.map(l=><a href={l.url} target="_blank" rel="noreferrer">{l.label} ↗</a>)}</div></section>)}
{!article&&post.closing&&<section class="research-section prose" id="closing"><h2>Questions to take away</h2><p set:html={md.renderInline(post.closing)}/></section>}
{article&&<p style="margin-top:30px"><a class="text-link" href={bondUrl(post)}>Read the full daily briefing →</a></p>}
<aside class="editor-note">This piece is edited from an AI briefing for the date shown. Research findings, institutional statements, and application ideas may rest on different levels of evidence. The date refers to the briefing; the sources may have been published earlier.</aside>
<details class="original-details"><summary>Show the original briefing text</summary><div class="prose" set:html={md.render(raw)}/></details><Ad name="article-end"/>
{related.length>0&&<section class="related"><h2>More on the same research</h2>{related.map(p=><a href={bondUrl(p)}><time>{dateLabel(p.date)}</time>{p.title} ↗</a>)}</section>}
</article>{!article&&<details class="toc" open><summary>Today's research</summary>{articles.map((a,i)=><a href={'#note-'+a.id}>{String(i+1).padStart(2,'0')} · {a.heading}</a>)}<a href="#closing">Questions to take away</a></details>}</div></div>
</Shell>
