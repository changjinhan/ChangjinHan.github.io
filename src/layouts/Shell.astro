---
import '../styles/global.css';
import Ad from '../components/Ad.astro';
const {title = '한창진의 블로그', description = '음성 AI 논문 리뷰, 발표 자료, 그리고 Bondnote 채권 연구 모음.', section = 'home', ads = true, image = '/assets/images/bio-profile.jpg', article = false} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [{href:'/',label:'홈',id:'home'},{href:'/blog/',label:'글',id:'blog'},{href:'/about/',label:'소개',id:'about'},{href:'/publications/',label:'Publications',id:'publications'},{href:'/bondnote/',label:'Bondnote',id:'bondnote'}];
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title} — Deep Log</title><meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/><link rel="icon" href="/assets/images/favicon/favicon.ico"/>
  <link rel="alternate" type="application/rss+xml" title="Deep Log" href="/feed.xml"/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:image" content={new URL(image,Astro.site)}/>
  <meta name="theme-color" content="#f7f7f2"/>
  <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('deep-log-theme')||'light'}catch{}</script>
  {ads && <script is:inline>if(location.hostname==='changjinhan.github.io'){const adScript=document.createElement('script');adScript.async=true;adScript.src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5927336110095461';adScript.crossOrigin='anonymous';document.head.appendChild(adScript);}</script>}
</head>
<body>
  <a class="skip-link" href="#main">본문으로 이동</a>
  <header class="site-header wrap">
    <a class="brand" href="/" aria-label="Deep Log 홈"><span class="brand-mark">d<span>l</span>.</span> deep log<span class="brand-dot">®</span></a>
    <nav aria-label="주 메뉴">{nav.map(n=><a href={n.href} aria-current={section===n.id?'page':undefined}>{n.label}</a>)}</nav>
    <div class="header-tools"><a class="icon-button" href="/blog/#search" aria-label="글 검색"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></a><button class="icon-button" id="theme-toggle" aria-label="다크 모드로 전환" title="테마 전환"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 15.3A8.6 8.6 0 0 1 8.7 4 8.6 8.6 0 1 0 20 15.3Z"/></svg></button></div>
  </header>
  <main id="main"><slot/></main>
  {ads && <div class="wrap"><Ad/></div>}
  <footer class="site-footer wrap"><div><a class="brand footer-brand" href="/">deep log.</a><p>논문 리뷰와 작업한 것들을 올립니다.</p></div><div class="footer-links"><a href="mailto:cjhanist@gmail.com">Email ↗</a><a href="https://github.com/ChangjinHan">GitHub ↗</a><a href="/feed.xml">RSS ↗</a><span>© {new Date().getFullYear()} Changjin Han</span></div></footer>
  <script>
    const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
    const updateLabel = () => button?.setAttribute('aria-label',document.documentElement.dataset.theme==='dark'?'라이트 모드로 전환':'다크 모드로 전환');
    updateLabel();
    button?.addEventListener('click',()=>{const theme=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=theme;try{localStorage.setItem('deep-log-theme',theme)}catch{}updateLabel()});
    // Preserve both original ad placements; never load live advertising in local preview.
    if (location.hostname==='changjinhan.github.io') document.querySelectorAll('.adsbygoogle').forEach(()=>{try{(window as any).adsbygoogle=(window as any).adsbygoogle||[];(window as any).adsbygoogle.push({})}catch{}});
  </script>
</body>
</html>
