---
import {dateLabel,topicFor} from '../lib/content.mjs';
const {post, number} = Astro.props;
---
<article class="post-row">
  <div class="post-date"><time datetime={post.date}>{dateLabel(post.date)}</time><span>{post.minutes} min read</span></div>
  <div class="post-copy"><span class="eyebrow">{topicFor(post)}</span><h3><a href={post.url} lang={/[가-힣]/.test(post.displayTitle)?'ko':'en'}>{post.displayTitle}</a></h3><p lang={/[가-힣]/.test(post.description)?'ko':'en'}>{post.description}</p></div>
  <a class="row-arrow" href={post.url} aria-label={`Read ${post.displayTitle}`}>↗</a>
</article>
