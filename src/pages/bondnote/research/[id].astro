---
import {bondPosts} from '../../../lib/content.mjs';
import BondPost from '../../../layouts/BondPost.astro';
export function getStaticPaths(){return bondPosts.flatMap(post=>post.articles.map(article=>({params:{id:article.id},props:{post,article}})))}
const {post,article}=Astro.props;
---
<BondPost post={post} article={article}/>
