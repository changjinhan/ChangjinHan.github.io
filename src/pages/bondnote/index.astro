---
import Shell from '../../layouts/Shell.astro';
import '../../styles/bondnote.css';
import {stripFacts} from '../../../scripts/lib/bondnote-editorial.mjs';
import {bondPosts,bondData,bondArticles,bondCategories,bondUrl,articleUrl,dateLabel,clean,md} from '../../lib/content.mjs';
const latest=bondPosts[0];
const articles=bondPosts.flatMap(p=>p.articles.map(a=>({...a,date:p.date,original:bondArticles.find(r=>r.id===a.id)})));
const categoryLabels=['Rates & curves','Credit','Trading & liquidity','AI & models','Risk & portfolios','Quant firms'];
---
<Shell title="Bondnote — AI and bond market reading notes" section="bondnote"><div class="wrap bn-archive">
<div class="bond-heading"><header class="page-heading"><span class="eyebrow">FIXED INCOME × ARTIFICIAL INTELLIGENCE</span><h1>bond<span class="serif accent">note.</span></h1><p>Questions, research, and desk notes.<br/>A daily notebook on AI in the bond market.</p></header><div class="bond-stats"><div><strong>{bondPosts.length}</strong><span>Briefings</span></div><div><strong>{bondArticles.length}</strong><span>Research & articles</span></div><div><strong>{latest.date.slice(5).replace('-','.')}</strong><span>Latest entry</span></div></div></div>
<div class="search-panel"><input id="bond-search" type="search" placeholder="Search research, topics, or text" aria-label="Search Bondnote"/><select id="bond-month" aria-label="Briefing month"><option value="">All dates</option>{[...new Set(bondPosts.map(p=>p.date.slice(0,7)))].map(m=><option value={m}>{new Date(`${m}-01T00:00:00Z`).toLocaleString('en-US',{month:'long',year:'numeric',timeZone:'UTC'})}</option>)}</select></div>
<div class="filter-tabs" aria-label="Research topics">{['All',...bondCategories].map((c,i)=><button data-category={c} aria-pressed={i===0?'true':'false'}>{i===0?'All':categoryLabels[i-1]}</button>)}</div>
<section class="bond-latest" id="latest-briefing"><div><span class="eyebrow">LATEST BRIEFING · {dateLabel(latest.date)}</span><h2><a href={bondUrl(latest)} lang={/[가-힣]/.test(latest.title)?'ko':'en'}>{latest.title}</a></h2><p lang="ko">{stripFacts(latest.intro)}</p></div><a href={bondUrl(latest)} aria-label="Read the latest briefing">↗</a></section>
<div class="view-tabs" aria-label="Archive view"><button data-view="daily" aria-pressed="true">Daily briefings</button><button data-view="research" aria-pressed="false">Research library</button></div>
<div class="results-meta"><span id="bond-count" aria-live="polite">{bondPosts.length} briefings · newest first</span><button class="reset-button" id="bond-reset">Reset filters</button></div>
<section class="bond-list" id="bond-daily" aria-label="Daily briefings">{bondPosts.map(p=>{const original=bondData.briefings.find(b=>b.id===p.id);return <article class="bond-item" data-bond-item data-view="daily" data-date={p.date} data-search={clean(p.title+' '+p.intro+' '+original.body).toLowerCase()} data-categories={[...new Set(original.articles.flatMap(a=>a.tags))].join('|')}><div class="item-meta"><time datetime={p.date}>{dateLabel(p.date)}</time><span>↗</span></div><h3><a href={bondUrl(p)}>{p.title}</a></h3><p set:html={md.renderInline(stripFacts(p.intro))}/><span class="small-label">{p.articles.length} RESEARCH NOTES · {p.readMinutes} MIN</span></article>})}</section>
<section class="bond-list" id="bond-research" aria-label="Research library" hidden>{articles.map(a=><article class="bond-item" data-bond-item data-view="research" data-date={a.date} data-categories={a.original.tags.join('|')} data-search={clean(a.heading+' '+a.originalTitle+' '+a.original.body).toLowerCase()}><div class="item-meta"><time>{dateLabel(a.date)}</time><span>↗</span></div><h3><a href={articleUrl(a)}>{a.heading}</a></h3><p set:html={md.renderInline(stripFacts(a.question))}/><span class="small-label">{a.original.tags.map(t=>categoryLabels[bondCategories.indexOf(t)]||t).join(' / ')}</span></article>)}</section>
<div id="bond-empty" class="empty-state" hidden><h3>No matching results.</h3><p>Try another search term or date.</p></div><button id="bond-more" class="load-more" hidden>Load more entries ↓</button>
<aside class="bond-info"><p>{bondPosts.length} briefings · {bondArticles.length} research notes & articles · last collected {dateLabel(bondData.updatedAt.slice(0,10))}</p><p>Each note links to its sources, evidence record, and original briefing text.</p>{bondData.missing.length>0&&<p>Original text pending: {bondData.missing.join(', ')} · added when available.</p>}</aside>
</div><script>
const items=Array.from(document.querySelectorAll<HTMLElement>('[data-bond-item]'));const search=document.querySelector<HTMLInputElement>('#bond-search')!;const month=document.querySelector<HTMLSelectElement>('#bond-month')!;const cats=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category]'));const views=Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-view]'));let category='All',view='daily',limit=12;
function render(){const q=search.value.toLowerCase().trim();const matches=items.filter(i=>i.dataset.view===view&&(!month.value||i.dataset.date?.startsWith(month.value))&&(category==='All'||i.dataset.categories?.split('|').includes(category))&&(!q||i.dataset.search?.includes(q)));items.forEach(i=>i.hidden=true);matches.slice(0,limit).forEach(i=>i.hidden=false);document.querySelector<HTMLElement>('#bond-daily')!.hidden=view!=='daily';document.querySelector<HTMLElement>('#bond-research')!.hidden=view!=='research';document.querySelector('#bond-count')!.textContent=`${matches.length} ${view==='daily'?'briefings':'research notes'} · newest first`;document.querySelector<HTMLElement>('#bond-empty')!.hidden=matches.length>0;document.querySelector<HTMLElement>('#bond-more')!.hidden=matches.length<=limit;document.querySelector<HTMLElement>('#latest-briefing')!.hidden=!!q||!!month.value||category!=='All'||view!=='daily';cats.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.category===category)));views.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.view===view)));}
search.addEventListener('input',()=>{limit=12;render()});month.addEventListener('change',()=>{limit=12;render()});cats.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category!;limit=12;render()}));views.forEach(b=>b.addEventListener('click',()=>{view=b.dataset.view!;limit=12;render()}));document.querySelector('#bond-more')!.addEventListener('click',()=>{limit+=12;render()});document.querySelector('#bond-reset')!.addEventListener('click',()=>{search.value='';month.value='';category='All';limit=12;render()});render();
</script></Shell>
