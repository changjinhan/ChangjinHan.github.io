---
import Shell from '../../layouts/Shell.astro';
import {bondPosts,bondData,bondArticles,bondCategories,bondUrl,articleUrl,dateLabel,clean} from '../../lib/content.mjs';
const latest=bondPosts[0];
const articles=bondPosts.flatMap(p=>p.articles.map(a=>({...a,date:p.date,original:bondArticles.find(r=>r.id===a.id)})));
---
<Shell title="Bondnote — 채권시장 AI 연구 노트" section="bondnote"><div class="wrap">
<div class="bond-heading"><header class="page-heading"><span class="eyebrow">FIXED INCOME × ARTIFICIAL INTELLIGENCE</span><h1>bond<span class="serif accent">note.</span></h1><p>채권시장에 AI를 어떻게 쓰는지 궁금해서 읽은 자료를 모았습니다.<br/>날짜나 주제별로 찾아보고, 출처와 원문도 확인할 수 있습니다.</p></header><div class="bond-stats"><div><strong>{bondPosts.length}</strong><span>브리핑</span></div><div><strong>{bondArticles.length}</strong><span>연구 · 기사</span></div><div><strong>{latest.date.slice(5).replace('-','.')}</strong><span>최근 기록</span></div></div></div>
<div class="search-panel"><input id="bond-search" type="search" placeholder="연구 제목, 내용, 키워드 검색" aria-label="Bondnote 검색"/><select id="bond-month" aria-label="브리핑 월"><option value="">모든 기간</option>{[...new Set(bondPosts.map(p=>p.date.slice(0,7)))].map(m=><option value={m}>{m.replace('-','년 ')}월</option>)}</select></div>
<div class="filter-tabs" aria-label="연구 주제">{['전체',...bondCategories].map((c,i)=><button data-category={c} aria-pressed={i===0?'true':'false'}>{c}</button>)}</div>
<section class="bond-latest" id="latest-briefing"><div><span class="eyebrow">LATEST BRIEFING · {dateLabel(latest.date)}</span><h2><a href={bondUrl(latest)}>{latest.title}</a></h2><p>{latest.intro}</p></div><a href={bondUrl(latest)} aria-label="최신 브리핑 읽기">↗</a></section>
<div class="view-tabs" aria-label="아카이브 보기 방식"><button data-view="daily" aria-pressed="true">날짜별 브리핑</button><button data-view="research" aria-pressed="false">연구 라이브러리</button></div>
<div class="results-meta"><span id="bond-count" aria-live="polite">{bondPosts.length}회 브리핑 · 최신순</span><button class="reset-button" id="bond-reset">필터 초기화</button></div>
<section class="bond-list" id="bond-daily" aria-label="날짜별 브리핑">{bondPosts.map(p=>{const original=bondData.briefings.find(b=>b.id===p.id);return <article class="bond-item" data-bond-item data-view="daily" data-date={p.date} data-search={clean(p.title+' '+p.intro+' '+original.body).toLowerCase()} data-categories={[...new Set(original.articles.flatMap(a=>a.tags))].join('|')}><div class="item-meta"><time datetime={p.date}>{dateLabel(p.date)}</time><span>↗</span></div><h3><a href={bondUrl(p)}>{p.title}</a></h3><p>{p.intro}</p><span class="small-label">{p.articles.length} RESEARCH NOTES · {p.readMinutes} MIN</span></article>})}</section>
<section class="bond-list" id="bond-research" aria-label="연구 라이브러리" hidden>{articles.map(a=><article class="bond-item" data-bond-item data-view="research" data-date={a.date} data-categories={a.original.tags.join('|')} data-search={clean(a.heading+' '+a.originalTitle+' '+a.original.body).toLowerCase()}><div class="item-meta"><time>{dateLabel(a.date)}</time><span>↗</span></div><h3><a href={articleUrl(a)}>{a.heading}</a></h3><p>{a.paragraphs[0]}</p><span class="small-label">{a.original.tags.join(' / ')}</span></article>)}</section>
<div id="bond-empty" class="empty-state" hidden><h3>검색 결과가 없습니다.</h3><p>다른 검색어나 기간으로 찾아보세요.</p></div><button id="bond-more" class="load-more" hidden>더 많은 기록 보기 ↓</button>
<aside class="bond-info"><p>브리핑 {bondPosts.length}회 · 연구·기사 {bondArticles.length}개 · 최근 수집 {dateLabel(bondData.updatedAt.slice(0,10))}</p><p>기존 AI 브리핑을 재편집한 연구 아카이브입니다. 각 글에서 출처와 편집 전 원문을 함께 확인할 수 있습니다.</p>{bondData.missing.length>0&&<p>원문 미확인: {bondData.missing.join(', ')} · 원문 확인 시 추가됩니다.</p>}</aside>
</div><script>
const items=Array.from(document.querySelectorAll<HTMLElement>('[data-bond-item]'));const search=document.querySelector<HTMLInputElement>('#bond-search')!;const month=document.querySelector<HTMLSelectElement>('#bond-month')!;const cats=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category]'));const views=Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-view]'));let category='전체',view='daily',limit=12;
function render(){const q=search.value.toLowerCase().trim();const matches=items.filter(i=>i.dataset.view===view&&(!month.value||i.dataset.date?.startsWith(month.value))&&(category==='전체'||i.dataset.categories?.split('|').includes(category))&&(!q||i.dataset.search?.includes(q)));items.forEach(i=>i.hidden=true);matches.slice(0,limit).forEach(i=>i.hidden=false);document.querySelector<HTMLElement>('#bond-daily')!.hidden=view!=='daily';document.querySelector<HTMLElement>('#bond-research')!.hidden=view!=='research';document.querySelector('#bond-count')!.textContent=`${matches.length}${view==='daily'?'회 브리핑':'개 연구·기사'} · 최신순`;document.querySelector<HTMLElement>('#bond-empty')!.hidden=matches.length>0;document.querySelector<HTMLElement>('#bond-more')!.hidden=matches.length<=limit;document.querySelector<HTMLElement>('#latest-briefing')!.hidden=!!q||!!month.value||category!=='전체'||view!=='daily';cats.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.category===category)));views.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.view===view)));}
search.addEventListener('input',()=>{limit=12;render()});month.addEventListener('change',()=>{limit=12;render()});cats.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category!;limit=12;render()}));views.forEach(b=>b.addEventListener('click',()=>{view=b.dataset.view!;limit=12;render()}));document.querySelector('#bond-more')!.addEventListener('click',()=>{limit+=12;render()});document.querySelector('#bond-reset')!.addEventListener('click',()=>{search.value='';month.value='';category='전체';limit=12;render()});render();
</script></Shell>
