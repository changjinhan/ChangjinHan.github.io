---
import Shell from '../layouts/Shell.astro';
import {posts,bondPosts,bondUrl,dateLabel} from '../lib/content.mjs';
const recent=posts.slice(0,3);
const latestBond=bondPosts[0];
const work=[
  {year:'2025',title:'StableFormTTS · ICASSP',description:'Improving the stability of formant generation in zero-shot speech synthesis.'},
  {year:'2023',title:'Chinese G2P · ICASSP',description:'Using neighboring characters to improve Chinese grapheme-to-phoneme conversion.'},
  {year:'2021',title:'Scene Graph Retrieval · AAAI',description:'Learning scene graph similarity for image retrieval.'}
];
---
<Shell>
  <div class="wrap archer-home">
    <section class="home-hero" aria-labelledby="home-title">
      <img class="hero-portrait" src="/assets/images/profile.png" alt="Portrait of Changjin Han" width="1106" height="1422"/>
      <div class="hero-main">
        <h1 id="home-title">Changjin Han.<br/><span>I read, build,<br/>and write.</span></h1>
        <div class="hero-links"><a href="/blog/">Read posts</a><a href="/about/">About me</a><a href="mailto:cjhanist@gmail.com">Email</a></div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="recent-title">
      <div class="section-bar"><h2 id="recent-title">§ Recent writing</h2><a href="/blog/">All posts →</a></div>
      <div class="editorial-list">{recent.map(post=><a class="editorial-row" href={post.url}><time datetime={post.date}>{dateLabel(post.date)}</time><strong lang={/[가-힣]/.test(post.displayTitle)?'ko':'en'}>{post.displayTitle}</strong><span class="row-kind">BLOG</span><span class="row-direction" aria-hidden="true">↗</span></a>)}</div>
    </section>

    <section class="home-section" aria-labelledby="work-title">
      <div class="section-bar"><h2 id="work-title">§ Research & talks</h2><a href="/publications/">View all →</a></div>
      <div class="work-list">{work.map(item=><div class="work-row"><span class="work-year">{item.year}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></div>)}</div>
    </section>

    <section class="home-section home-bondnote" aria-labelledby="bond-title">
      <div class="section-bar"><h2 id="bond-title">§ Bondnote</h2><a href="/bondnote/">Archive →</a></div>
      <p class="section-intro">A dated reading log on AI and the bond market.</p>
      {latestBond&&<a class="editorial-row" href={bondUrl(latestBond)}><time datetime={latestBond.date}>{dateLabel(latestBond.date)}</time><strong lang={/[가-힣]/.test(latestBond.title)?'ko':'en'}>{latestBond.title}</strong><span class="row-kind">BRIEFING</span><span class="row-direction" aria-hidden="true">↗</span></a>}
    </section>
  </div>
</Shell>
