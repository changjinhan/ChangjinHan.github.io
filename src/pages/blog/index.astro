---
import Shell from '../../layouts/Shell.astro';
import PostRow from '../../components/PostRow.astro';
import {posts,topics,topicFor,clean} from '../../lib/content.mjs';
---
<Shell title="Posts" section="blog"><div class="wrap archive">
<header class="page-heading"><span class="eyebrow">BLOG</span><h1>Notes <span class="serif accent">& writing.</span></h1><p>Paper reviews and things I've learned along the way. Search by title or topic.</p></header>
<div class="search-panel" id="search"><input id="blog-search" type="search" placeholder="Search titles, text, or tags" aria-label="Search posts"/><select id="blog-year" aria-label="Year published"><option value="">All years</option>{[...new Set(posts.map(p=>p.date.slice(0,4)))].map(y=><option>{y}</option>)}</select></div>
<div class="filter-tabs" aria-label="Post topics">{topics.map((t,i)=><button data-topic={t} aria-pressed={i===0?'true':'false'}>{t}</button>)}</div>
<div class="results-meta"><span id="result-count" aria-live="polite">{posts.length} posts</span><div><a href="/tags/">Browse tags ↗</a> · <button class="reset-button" id="reset-filters">Reset filters</button></div></div>
<div id="post-list">{posts.map(p=><div data-post data-topic={topicFor(p)} data-year={p.date.slice(0,4)} data-search={clean([p.title,p.description,...p.tags,p.content].join(' ')).toLowerCase()}><PostRow post={p}/></div>)}</div>
<div class="empty-state" id="empty-results" hidden><h3>No matching posts.</h3><p>Try another search or topic.</p></div>
<button class="load-more" id="more-posts" hidden>Load more posts ↓</button>
</div>
<script>
const items=Array.from(document.querySelectorAll<HTMLElement>('[data-post]'));const search=document.querySelector<HTMLInputElement>('#blog-search')!;const year=document.querySelector<HTMLSelectElement>('#blog-year')!;const buttons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-topic]:not([data-post])'));let topic='All',limit=12;
const params=new URLSearchParams(location.search);search.value=params.get('q')||'';topic=params.get('topic')||'All';if(!buttons.some(b=>b.dataset.topic===topic))topic='All';
function render(){const q=search.value.trim().toLowerCase();const matched=items.filter(i=>(topic==='All'||i.dataset.topic===topic)&&(!year.value||i.dataset.year===year.value)&&(!q||i.dataset.search?.includes(q)));items.forEach(i=>i.hidden=true);matched.slice(0,limit).forEach(i=>i.hidden=false);document.querySelector('#result-count')!.textContent=`${matched.length} posts`;document.querySelector<HTMLElement>('#empty-results')!.hidden=matched.length!==0;document.querySelector<HTMLElement>('#more-posts')!.hidden=matched.length<=limit;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.topic===topic)));}
search.addEventListener('input',()=>{limit=12;render()});year.addEventListener('change',()=>{limit=12;render()});buttons.forEach(b=>b.addEventListener('click',()=>{topic=b.dataset.topic!;limit=12;render()}));document.querySelector('#more-posts')!.addEventListener('click',()=>{limit+=12;render()});document.querySelector('#reset-filters')!.addEventListener('click',()=>{topic='All';search.value='';year.value='';limit=12;render()});render();if(location.hash==='#search')search.focus();
</script></Shell>
