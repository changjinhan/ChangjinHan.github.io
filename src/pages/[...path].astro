---
import {postPaths} from '../lib/content.mjs';
import Post from '../layouts/Post.astro';
import Shell from '../layouts/Shell.astro';
export const getStaticPaths = postPaths;
const {post,alias}=Astro.props;
---
{post?<Post post={post}/>:<Shell title="Post moved" section="blog" ads={false}><div class="wrap page-heading"><h1>This post has moved.</h1><a class="text-link" href={alias.target}>Read it at its new address →</a></div><meta http-equiv="refresh" content={`0;url=${alias.target}`}/></Shell>}
